// ═══════════════════════════════════════════════════════════════════
// Plataforma de Predicción de Deserción Estudiantil
// Schema Prisma — MySQL 8 (InnoDB, UTF8MB4)
//
// Spec: Sección 3.2 — Esquema Relacional Completo
// Correcciones aplicadas: D3 (RefreshToken), D5 (Enrollment), D7 (StudentStatus)
// ═══════════════════════════════════════════════════════════════════

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  DIRECTOR
  TUTOR
  STUDENT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  DROPPED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum InterventionStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

// D13 — Estado de trabajos batch de ML
enum BatchJobStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// ==========================================
// SISTEMA Y USUARIOS
// ==========================================

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique @db.VarChar(191)
  password      String         @db.VarChar(255)
  name          String         @db.VarChar(191)
  role          Role           @default(TUTOR)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  interventions  Intervention[] @relation("AssignedTutor")
  auditLogs      AuditLog[]
  refreshTokens  RefreshToken[]

  studentId      Int?           @unique
  student        Student?       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("users")
}

// D3 — Refresh Tokens almacenados en MySQL
model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @db.VarChar(100)
  details   Json?
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// ESTRUCTURA ACADÉMICA INSTITUCIONAL
// ==========================================

model Faculty {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  careers Career[]

  @@map("faculties")
}

model Career {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(191)
  facultyId Int
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students Student[]

  @@index([facultyId])
  @@map("careers")
}

model Semester {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(50) // Ej: "2026-A"
  name      String   @db.VarChar(100)
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]

  @@map("semesters")
}

// Un Course es la oferta de una materia en un semestre concreto.
// La misma materia (code) en semestres distintos genera registros
// Course diferentes, lo que permite re-matriculación natural en Enrollment.
model Course {
  id         Int      @id @default(autoincrement())
  code       String   @db.VarChar(50)
  name       String   @db.VarChar(191)
  credits    Int
  semesterId Int
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  enrollments Enrollment[]

  @@unique([code, semesterId]) // Cada código de materia es único por semestre
  @@index([semesterId])
  @@map("courses")
}

// ==========================================
// ESTUDIANTES Y REGISTRO OPERATIVO
// ==========================================

// D7 — status convertido a enum StudentStatus
model Student {
  id              Int           @id @default(autoincrement())
  studentCode     String        @unique @db.VarChar(50)
  firstName       String        @db.VarChar(100)
  lastName        String        @db.VarChar(100)
  email           String        @unique @db.VarChar(191)
  careerId        Int
  career          Career        @relation(fields: [careerId], references: [id])
  currentSemester Int           @default(1)
  status          StudentStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  enrollments     Enrollment[]
  payments        Payment[]
  academicRecords AcademicRecord[]
  predictions     Prediction[]
  predHistories   PredictionHistory[]
  interventions   Intervention[]
  user            User?

  @@index([careerId])
  @@index([status])
  @@map("students")
}

// D5 — Enrollment permite re-matriculación en diferentes semestres.
// Course ya está vinculado a un Semester específico (Course.semesterId),
// por lo que el mismo código de materia en distintos periodos genera
// registros Course diferentes con IDs distintos.
// La constraint @@unique([studentId, courseId]) asegura unicidad por
// combinación estudiante-curso, permitiendo repetición natural.
model Enrollment {
  id         Int      @id @default(autoincrement())
  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  finalGrade Float?   @db.Float
  createdAt  DateTime @default(now())

  attendances Attendance[]

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@map("enrollments")
}

model Attendance {
  id           Int              @id @default(autoincrement())
  enrollmentId Int
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  createdAt    DateTime         @default(now())

  @@index([enrollmentId])
  @@index([date])
  @@map("attendances")
}

model Payment {
  id          Int           @id @default(autoincrement())
  studentId   Int
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(10, 2)
  dueDate     DateTime
  paymentDate DateTime?
  status      PaymentStatus @default(PENDING)
  concept     String        @db.VarChar(191)
  createdAt   DateTime      @default(now())

  @@index([studentId])
  @@index([status])
  @@map("payments")
}

// D6 — period se mantiene como String para compatibilidad con datos externos
model AcademicRecord {
  id             Int      @id @default(autoincrement())
  studentId      Int
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  period         String   @db.VarChar(50)
  gpa            Float    @db.Float
  failedSubjects Int      @default(0)
  attendanceRate Float    @db.Float
  lmsScore       Float    @default(0.0) @db.Float
  createdAt      DateTime @default(now())

  @@index([studentId])
  @@map("academic_records")
}

// ==========================================
// BATCH JOBS, MODELO PREDICTIVO E INTERVENCIONES
// ==========================================

// D13 — Tracking persistente de trabajos batch de inferencia ML
// Spec: Sección 12.4 — POST /predictions/batch-run
model BatchJob {
  id            Int            @id @default(autoincrement())
  jobId         String         @unique @db.VarChar(100) // e.g. "job_batch_20260802_001"
  semesterCode  String         @db.VarChar(50)
  status        BatchJobStatus @default(PROCESSING)
  forceRetrain  Boolean        @default(false)
  totalStudents Int?           // Total students processed
  processedAt   DateTime?      // When processing completed
  errorMessage  String?        @db.Text
  triggeredById Int?           // User who triggered the job
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("batch_jobs")
}

model Prediction {
  id             Int       @id @default(autoincrement())
  studentId      Int
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score          Float     @db.Float
  riskLevel      RiskLevel
  topRiskFactors Json
  modelVersion   String    @db.VarChar(50)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@index([studentId])
  @@index([riskLevel])
  @@map("predictions")
}

model PredictionHistory {
  id             Int       @id @default(autoincrement())
  studentId      Int
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score          Float     @db.Float
  riskLevel      RiskLevel
  topRiskFactors Json
  modelVersion   String    @db.VarChar(50)
  calculatedAt   DateTime  @default(now())

  @@index([studentId])
  @@index([calculatedAt])
  @@map("prediction_histories")
}

model Intervention {
  id         Int                @id @default(autoincrement())
  studentId  Int
  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  userId     Int
  assignedTo User               @relation("AssignedTutor", fields: [userId], references: [id])
  status     InterventionStatus @default(PENDING)
  title      String             @db.VarChar(191)
  notes      String             @db.Text
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([studentId])
  @@index([userId])
  @@index([status])
  @@map("interventions")
}

// ==========================================
// IMPORT JOBS (MÓDULO 10)
// ==========================================

model ImportJob {
  id           Int            @id @default(autoincrement())
  jobId        String         @unique @db.VarChar(100)
  fileName     String         @db.VarChar(255)
  status       BatchJobStatus @default(PROCESSING)
  totalRecords Int?
  processed    Int            @default(0)
  errorMessage String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@map("import_jobs")
}
