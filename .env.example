# ═══════════════════════════════════════════════
# Plataforma de Predicción de Deserción Estudiantil
# Variables de Entorno (.env.example)
# ═══════════════════════════════════════════════

# ── Base de Datos (MySQL 8 via Docker) ──
DATABASE_URL="mysql://desercion_user:desercion_pass@localhost:3306/desercion_db"
MYSQL_ROOT_PASSWORD="root_password_cambiar"
MYSQL_DATABASE="desercion_db"
MYSQL_USER="desercion_user"
MYSQL_PASSWORD="desercion_pass"

# ── JWT (HS256) ──
JWT_SECRET="cambiar-en-produccion-clave-minimo-256-bits-segura"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ── Servicio de Machine Learning (FastAPI) ──
ML_SERVICE_URL="http://localhost:8000"
ML_API_KEY="ml-api-key-cambiar-en-produccion"

# ── Next.js ──
NEXT_PUBLIC_APP_NAME="Plataforma de Deserción Estudiantil"
NODE_ENV="development"
